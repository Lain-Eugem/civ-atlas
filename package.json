{
  "name": "civ-atlas",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": "https://github.com/guaner-334/civ-atlas",
  "version": "1.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit && tsc -p examples/plugins",
    "test": "vitest run",
    "snap": "tsx scripts/snap.ts",
    "stress": "tsx scripts/stress.ts",
    "smoke": "tsx scripts/replay-check.ts",
    "test:visual": "tsx scripts/visual-check.ts",
    "test:sandbox": "tsx scripts/sandbox-check.ts",
    "size": "tsx scripts/first-load.ts",
    "mcp:build": "powershell -NoProfile -ExecutionPolicy Bypass -File mcp/build.ps1",
    "mcp:selftest": "node mcp/.build/mcp/selftest.js",
    "mcp:selftest:protocol": "node mcp/.build/mcp/selftest-protocol.js",
    "mcp:selftest:monarch": "node mcp/.build/mcp/selftest-monarch.js",
    "mcp:serve": "node mcp/.build/mcp/server.js"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "d3-delaunay": "^6.0.4",
    "mediabunny": "1.61.3",
    "quickjs-emscripten-core": "0.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simplex-noise": "^4.0.3",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@types/d3-delaunay": "^6.0.4",
    "@types/node": "^26.6.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.2.7",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "subset-font": "^2.9.0",
    "tsx": "^4.23.15",
    "typescript": "~5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  }
}
